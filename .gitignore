# Dependencies
node_modules/

# Environment (secrets — NEVER commit)
server/.env

# Live config (contains team-specific data — NEVER commit)
# Use darkhan.config.example.json as a template
server/darkhan.config.json

# Live workers (team-specific — NEVER commit)
# Use server/workers/examples/ as templates
server/workers/*.worker.js
!server/workers/examples/*.worker.js
server/workers/_node1/

# Database (generated, contains user data — NEVER commit)
server/*.db
server/*.db-wal
server/*.db-shm
server/db/*.db
server/db/*.db-wal
server/db/*.db-shm
server/db/backups/

# Secrets database (credential-isolated — NEVER commit)
server/db/secrets.db

# Source maps (Anthropic-class leak prevention — NEVER publish)
*.map
!node_modules/**/*.map

# TLS certificates (private keys — NEVER commit)
*.key
*.pem
*.csr

# Runtime files
server/.darkhan.pid
server/.dev

# Transcripts (auto-generated, contain internal comms — NEVER commit)
docs/transcripts/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Session files
*.tmp

# Internal planning (team-specific — NEVER commit)
SPRINT.md
BACKLOG.md
server/workers/manifest.json

# Siege test artifacts (contain internal results — NEVER commit)
server/logs/siege-*
server/scripts/siege-*
