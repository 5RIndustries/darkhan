# Darkhan — Environment Configuration
# Copy to .env and fill in values before running.
# NEVER commit .env to version control.

# --- Server ---
PORT=3001
SESSION_SECRET=<generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
CORS_ORIGIN=http://localhost:3001

# --- Claude Relay ---
# Mode: 'cli' uses claude -p (default, Max plan, $0)
#       'sdk' uses Agent SDK (requires ANTHROPIC_API_KEY)
DARKHAN_RELAY_MODE=cli
CLAUDE_CLI_PATH=/home/youruser/.local/bin/claude

# --- Local LLM (Ollama) ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b

# --- Cloud LLM APIs (optional — required for cloud-based agents) ---
# GOOGLE_API_KEY=<your-google-api-key>
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# --- OpenAI (optional — for GPT consensus model) ---
# OPENAI_API_KEY=<your-openai-api-key>

# --- Security: Two-LLM Consensus (recommended for production) ---
# The security scanner runs two LLMs in parallel on every external/agent message
# and compares verdicts. Disagreement → quarantine. Primary is set by OLLAMA_MODEL
# above. Secondary is configured here.
#
# Recommended: both local, architecturally different families. Zero paid models
# on the security hot path. Example: Qwen 2.5 primary + Phi-4 secondary.
#   SECURITY_ESCALATION_PROVIDER=ollama
#   SECURITY_ESCALATION_MODEL=phi4
#
# Alternative: local primary + cloud secondary (e.g., Anthropic Haiku).
#   SECURITY_ESCALATION_PROVIDER=anthropic
#   SECURITY_ESCALATION_MODEL=claude-haiku-4-5
#
# If unset, consensus runs in single-model mode (primary only, flagged as such).

# --- VPS / Remote Deployment (optional — for virtual server deployments) ---
# Trust proxy for correct IP resolution behind reverse proxies (Caddy, nginx, Cloudflare)
# DARKHAN_TRUST_PROXY=true
# Comma-separated allowed origins for WebSocket connections
# DARKHAN_ALLOWED_ORIGINS=https://darkhan.example.com
# Enable secure cookie flags (set when behind HTTPS termination)
# DARKHAN_HTTPS=true
# Acknowledge external binding without TLS (not recommended — use Caddy or Tailscale instead)
# DARKHAN_ALLOW_EXTERNAL=true

