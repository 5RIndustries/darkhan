#!/bin/bash
#
# Darkhan — Pre-commit Secret Scanner
#
# Scans staged changes for credentials, API keys, and tokens.
# If secrets are found, the commit is blocked with a clear error.
#
# Install: git config core.hooksPath .githooks
# Or:      cp .githooks/pre-commit .git/hooks/pre-commit
#

# Find the scanner script relative to repo root
REPO_ROOT="$(git rev-parse --show-toplevel)"
SCANNER="$REPO_ROOT/server/scripts/secret-scanner.js"

if [ ! -f "$SCANNER" ]; then
  echo "[pre-commit] Warning: secret-scanner.js not found at $SCANNER"
  echo "[pre-commit] Skipping secret scan — install the scanner to enable."
  exit 0
fi

# Run the scanner against the staged diff
node "$SCANNER" --git-diff
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "[pre-commit] COMMIT BLOCKED — secrets detected in staged changes."
  echo "[pre-commit] Fix the issues above, re-stage, and try again."
  echo ""
  exit 1
fi

exit 0
